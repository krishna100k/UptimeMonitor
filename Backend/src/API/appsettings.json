{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "UptimeDb": "Host=Localhost;Port=5432;Database=UptimeDb;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/pulse-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": "5672",
    "Username": "guest",
    "Password": "guest"
  }
}
